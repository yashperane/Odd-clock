<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Odd Clock"
            android:textColor="@color/ink"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="सम मिनिटं कधीच नाहीत, फक्त विषम!"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/preview_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/preview_bg"
            android:minHeight="150dp"
            android:padding="14dp" />

        <TextView
            android:id="@+id/btn_add"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="＋  होमस्क्रीनवर विजेट जोडा"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="लूक" />

            <Switch
                android:id="@+id/sw_dark"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="डार्क थीम" />

            <Switch
                android:id="@+id/sw_marathi"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="मराठी अंक आणि तारीख (१०:२५)" />

            <Switch
                android:id="@+id/sw_fahrenheit"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="तापमान °F मध्ये" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="विषम नियम" />

            <RadioGroup
                android:id="@+id/rg_rule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_next"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="पुढचा विषम  (10:24 → 10:25)" />

                <RadioButton
                    android:id="@+id/rb_prev"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="मागचा विषम  (10:24 → 10:23)" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="हवामान आणि सूर्यास्त" />

            <Spinner
                android:id="@+id/sp_city"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_lat"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="Latitude"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <EditText
                    android:id="@+id/et_lon"
                    style="@style/Body"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:hint="Longitude"
                    android:inputType="numberDecimal|numberSigned"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="सेव्ह करा आणि हवामान रिफ्रेश करा"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">
            <TextView style="@style/SectionTitle" android:text="टिप" />
            <TextView
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="विजेड दर मिनिटाला वेळेवर अपडेट व्हावं यासाठी फोन सेटिंग्जमध्ये या ॲपची बॅटरी &quot;Unrestricted&quot; ठेवा. हवामानासाठी इंटरनेट लागतं, ते दर ३० मिनिटांनी अपडेट होतं."
                android:textSize="14sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>
